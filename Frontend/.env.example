# Copy to `.env` and adjust for your setup.
# Base URL of the SmartClass backend used by the Flutter app.
#   - Physical Android device (same Wi-Fi): http://<PC_LAN_IP>:3000
#   - Android emulator:                    http://10.0.2.2:3000
#   - Desktop/iOS simulator:               http://localhost:3000
API_BASE_URL=http://localhost:3000
