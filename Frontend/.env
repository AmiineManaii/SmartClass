# Single LAN Host IP (auto-updated by ..\set-ip.ps1; Flutter Web on localhost uses localhost automatically)
#   - Physical Android device / LAN browser: http://<HOST_IP>:3000
#   - Android emulator:                      set API_BASE_URL=http://10.0.2.2:3000
#   - Desktop / Web local:                   automatically uses http://localhost:3000
HOST_IP=192.168.100.107
# Optional explicit override (leave empty to derive from HOST_IP):
API_BASE_URL=
