  @@index([recordingId, userId, kind])
  @@map("student_lesson_artifacts")
}

model StudentQuizAttempt {
  id             String   @id @default(uuid()) @db.Uuid
  artifactId     String   @map("artifact_id") @db.Uuid
  recordingId    String   @map("recording_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  score          Int
  totalQuestions Int      @map("total_questions")
  answers        Json     @default("[]")
  results        Json     @default("[]")
  weakTopics     String[] @default([]) @map("weak_topics")
  completedAt    DateTime @default(now()) @map("completed_at") @db.Timestamptz

  artifact  StudentLessonArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  recording Recording             @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([recordingId, userId])
  @@map("student_quiz_attempts")
}

model StudentLessonProgress {
