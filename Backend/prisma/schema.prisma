datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TEACHER
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ClassLevel {
  LICENCE
  MASTER
  DOCTORAT
}

enum ClassStatus {
  DRAFT
  PUBLISHED
}

enum TimetableKind {
  CM
  TP
  TD
  BREAK
  LUNCH
  FREE
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
}

enum FraudStatus {
  UNTREATED
  IN_PROGRESS
  CLOSED
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique
  passwordHash        String     @map("password_hash")
  firstName           String     @map("first_name")
  lastName            String     @map("last_name")
  role                Role?
  birthDate           DateTime?  @map("birth_date") @db.Date
  status              UserStatus @default(ACTIVE)
  emailVerified       Boolean    @default(false) @map("email_verified")
  onboardingCompleted Boolean    @default(false) @map("onboarding_completed")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens        RefreshToken[]
  verificationCodes    EmailVerificationCode[]
  passwordResetCodes   PasswordResetCode[]
  groupMemberships     GroupMember[]
  teacherAssignments   TeacherAssignment[]
  taughtSlots          TimetableSlot[]        @relation("SlotTeacher")
  fraudReports         FraudReport[]
  referredClasses      ClassGroup[]           @relation("ClassReferent")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model ClassGroup {
  id             String      @id @default(uuid()) @db.Uuid
  name           String
  level          ClassLevel
  department     String?
  capacity       Int
  description    String?
  forumEnabled   Boolean     @default(true) @map("forum_enabled")
  entSyncEnabled Boolean     @default(true) @map("ent_sync_enabled")
  status         ClassStatus @default(PUBLISHED)
  referentId     String?     @map("referent_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  referent    User?               @relation("ClassReferent", fields: [referentId], references: [id], onDelete: SetNull)
  members     GroupMember[]
  teachers    TeacherAssignment[]
  slots       TimetableSlot[]
  fraudCases  FraudReport[]

  @@index([level])
  @@index([status])
  @@index([referentId])
  @@map("class_groups")
}

model GroupMember {
  id           String     @id @default(uuid()) @db.Uuid
  classGroupId String     @map("class_group_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  joinedAt     DateTime   @default(now()) @map("joined_at") @db.Timestamptz

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classGroupId, userId])
  @@index([classGroupId])
  @@index([userId])
  @@map("group_members")
}

model TeacherAssignment {
  id           String     @id @default(uuid()) @db.Uuid
  classGroupId String     @map("class_group_id") @db.Uuid
  teacherId    String     @map("teacher_id") @db.Uuid
  subject      String
  weeklyHours  String?    @map("weekly_hours")
  assignedAt   DateTime   @default(now()) @map("assigned_at") @db.Timestamptz

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacher    User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classGroupId, teacherId])
  @@index([classGroupId])
  @@index([teacherId])
  @@map("teacher_assignments")
}

model TimetableSlot {
  id           String        @id @default(uuid()) @db.Uuid
  classGroupId String        @map("class_group_id") @db.Uuid
  title        String
  subtitle     String?
  kind         TimetableKind
  startsAt     DateTime      @map("starts_at") @db.Timestamptz
  endsAt       DateTime      @map("ends_at") @db.Timestamptz
  teacherId    String?       @map("teacher_id") @db.Uuid
  room         String?
  statusNotes  Json          @default("[]") @map("status_notes")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacher    User?      @relation("SlotTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([classGroupId])
  @@index([startsAt])
  @@map("timetable_slots")
}

model FraudReport {
  id           String        @id @default(uuid()) @db.Uuid
  title        String
  context      String?
  severity     FraudSeverity
  status       FraudStatus   @default(UNTREATED)
  studentId    String?       @map("student_id") @db.Uuid
  studentName  String        @map("student_name")
  studentCode  String?       @map("student_code")
  classGroupId String?       @map("class_group_id") @db.Uuid
  className    String?       @map("class_name")
  findings     Json          @default("[]")
  reason       String?
  resolution   String?
  occurredAt   DateTime      @map("occurred_at") @db.Timestamptz
  closedAt     DateTime?     @map("closed_at") @db.Timestamptz
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  student    User?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  classGroup ClassGroup? @relation(fields: [classGroupId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([severity])
  @@index([studentId])
  @@index([occurredAt])
  @@map("fraud_reports")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  familyId  String   @map("family_id") @db.Uuid
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailVerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_codes")
}

model PasswordResetCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_codes")
}
