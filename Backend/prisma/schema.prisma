datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  TEACHER
  STUDENT
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ClassLevel {
  LICENCE
  MASTER
  DOCTORAT
}

enum ClassStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SectionStatus {
  PENDING
  GENERATED
  VALIDATED
}

enum PassageKind {
  SECTION
  REFINED
}

enum TeacherApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InvitationStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum TimetableKind {
  CM
  TP
  TD
  BREAK
  LUNCH
  FREE
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
}

enum FraudStatus {
  UNTREATED
  IN_PROGRESS
  CLOSED
}

enum VideoSessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELED
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique
  passwordHash          String                 @map("password_hash")
  firstName             String                 @map("first_name")
  lastName              String                 @map("last_name")
  role                  Role?
  teacherApprovalStatus TeacherApprovalStatus? @map("teacher_approval_status")
  birthDate             DateTime?              @map("birth_date") @db.Date
  status                UserStatus             @default(ACTIVE)
  emailVerified         Boolean                @default(false) @map("email_verified")
  onboardingCompleted   Boolean                @default(false) @map("onboarding_completed")
  failedLoginAttempts   Int                    @default(0) @map("failed_login_attempts")
  lockedUntil           DateTime?              @map("locked_until") @db.Timestamptz
  twoFactorEnabled      Boolean                @default(false) @map("two_factor_enabled")
  twoFactorSecret       String?                @map("two_factor_secret")
  twoFactorRecoveryCodes String[]              @default([]) @map("two_factor_recovery_codes")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  refreshTokens      RefreshToken[]
  verificationCodes  EmailVerificationCode[]
  passwordResetCodes PasswordResetCode[]
  groupMemberships   GroupMember[]
  teacherAssignments TeacherAssignment[]
  taughtSlots        TimetableSlot[]         @relation("SlotTeacher")
  fraudReports       FraudReport[]
  referredClasses    ClassGroup[]            @relation("ClassReferent")
  ownedClasses       ClassGroup[]            @relation("ClassOwner")
  authoredCourses    Course[]                @relation("AuthoredCourses")
  createdInvitations ClassInvitation[]       @relation("InvitationCreator")
  auditLogs          AuditLog[]
  coursePassages     CoursePassage[]
  hostedSessions          VideoSession[]              @relation("HostedSessions")
  sessionAttendances      SessionParticipant[]
  sessionChatMessages     SessionChatMessage[]
  sessionRemovalsReceived SessionParticipantRemoval[] @relation("ParticipantRemovals")
  sessionRemovalsExecuted SessionParticipantRemoval[] @relation("ExecutorRemovals")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([teacherApprovalStatus])
  @@map("users")
}

model ClassGroup {
  id             String      @id @default(uuid()) @db.Uuid
  name           String
  level          ClassLevel
  department     String?
  academicYear   String?     @map("academic_year")
  capacity       Int
  description    String?
  forumEnabled   Boolean     @default(true) @map("forum_enabled")
  entSyncEnabled Boolean     @default(true) @map("ent_sync_enabled")
  status         ClassStatus @default(PUBLISHED)
  isVirtual      Boolean     @default(false) @map("is_virtual")
  ownerId        String?     @map("owner_id") @db.Uuid
  referentId     String?     @map("referent_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  referent    User?               @relation("ClassReferent", fields: [referentId], references: [id], onDelete: SetNull)
  owner       User?               @relation("ClassOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members     GroupMember[]
  teachers    TeacherAssignment[]
  slots       TimetableSlot[]
  fraudCases  FraudReport[]
  invitations ClassInvitation[]
  courses     CourseClassGroup[]
  videoSessions VideoSession[]

  @@index([level])
  @@index([status])
  @@index([referentId])
  @@index([ownerId])
  @@index([isVirtual])
  @@map("class_groups")
}

model GroupMember {
  id           String   @id @default(uuid()) @db.Uuid
  classGroupId String   @map("class_group_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  joinedAt     DateTime @default(now()) @map("joined_at") @db.Timestamptz

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classGroupId, userId])
  @@index([classGroupId])
  @@index([userId])
  @@map("group_members")
}

model TeacherAssignment {
  id           String   @id @default(uuid()) @db.Uuid
  classGroupId String   @map("class_group_id") @db.Uuid
  teacherId    String   @map("teacher_id") @db.Uuid
  subject      String
  weeklyHours  String?  @map("weekly_hours")
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacher    User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classGroupId, teacherId, subject])
  @@index([classGroupId])
  @@index([teacherId])
  @@map("teacher_assignments")
}

model TimetableSlot {
  id           String        @id @default(uuid()) @db.Uuid
  classGroupId String        @map("class_group_id") @db.Uuid
  title        String
  subtitle     String?
  kind         TimetableKind
  startsAt     DateTime      @map("starts_at") @db.Timestamptz
  endsAt       DateTime      @map("ends_at") @db.Timestamptz
  teacherId    String?       @map("teacher_id") @db.Uuid
  room         String?
  statusNotes  Json          @default("[]") @map("status_notes")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  teacher    User?      @relation("SlotTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  videoSessions VideoSession[]

  @@index([classGroupId])
  @@index([startsAt])
  @@map("timetable_slots")
}

/// Teacher-generated course content (AI or manual). Saved as DRAFT on
/// generation: only the author (and admins) can read it until it is
/// validated (PUBLISHED), after which every authenticated user can read it.
model Course {
  id         String      @id @default(uuid()) @db.Uuid
  title      String
  subject    String?
  content    String      @db.Text
  /// Validated outline (plan) the teacher confirmed before section
  /// generation. JSON: {title, targetAudience, prerequisites[], sections[]}.
  outline    Json?
  level      String      @default("equilibre")
  difficulty String      @default("moyen")
  format     String      @default("resume")
  status     ClassStatus @default(DRAFT)
  authorId   String      @map("author_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  author      User               @relation("AuthoredCourses", fields: [authorId], references: [id], onDelete: Cascade)
  classGroups CourseClassGroup[]
  sections    CourseSection[]
  passages    CoursePassage[]
  videoSessions VideoSession[]

  @@index([status])
  @@index([authorId])
  @@map("courses")
}

/// One chapter of a course, generated and validated one by one. Content
/// is filled by the AI section stream, then frozen on VALIDATED (RG4:
/// the teacher's validation gates publication of the whole course).
model CourseSection {
  id               String        @id @default(uuid()) @db.Uuid
  courseId         String        @map("course_id") @db.Uuid
  /// Outline section key (e.g. "sec-1"), stable across regeneration.
  sectionKey       String        @map("section_key")
  title            String
  description      String        @default("")
  /// Key topics from the validated outline (obligatory notions to cover).
  keyTopics        String[]      @default([]) @map("key_topics")
  content          String?       @db.Text
  order            Int
  estimatedMinutes Int?          @map("estimated_minutes")
  status           SectionStatus @default(PENDING)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  course   Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  passages CoursePassage[]

  @@unique([courseId, sectionKey])
  @@index([courseId])
  @@index([status])
  @@map("course_sections")
}

/// Vector memory of a teacher's validated content (pgvector, 768-dim
/// EmbeddingGemma). Enables "remember the old course" context on section
/// generation/refinement. Strictly scoped by authorId (no cross-teacher
/// leakage). embedding is accessed ONLY via $queryRaw in the repository.
model CoursePassage {
  id        String                     @id @default(uuid()) @db.Uuid
  authorId  String                     @map("author_id") @db.Uuid
  courseId  String?                    @map("course_id") @db.Uuid
  sectionId String?                    @map("section_id") @db.Uuid
  subject   String?
  title     String                     @default("")
  content   String                     @db.Text
  kind      PassageKind                @default(SECTION)
  /// pgvector column — read/write exclusively via raw SQL in
  /// PrismaSectionMemoryAdapter (Prisma cannot type Unsupported("vector")).
  embedding Unsupported("vector(768)")
  createdAt DateTime                   @default(now()) @map("created_at") @db.Timestamptz

  author  User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  course  Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section CourseSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([subject])
  @@index([createdAt])
  @@map("course_passages")
}

model CourseClassGroup {
  id           String   @id @default(uuid()) @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  classGroupId String   @map("class_group_id") @db.Uuid
  assignedAt   DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  course     Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)

  @@unique([courseId, classGroupId])
  @@index([courseId])
  @@index([classGroupId])
  @@map("course_class_groups")
}

model ClassInvitation {
  id           String           @id @default(uuid()) @db.Uuid
  classGroupId String           @map("class_group_id") @db.Uuid
  codeHash     String           @unique @map("code_hash")
  codePrefix   String?          @map("code_prefix")
  creatorId    String           @map("creator_id") @db.Uuid
  status       InvitationStatus @default(ACTIVE)
  expiresAt    DateTime?        @map("expires_at") @db.Timestamptz
  maxUses      Int?             @map("max_uses")
  usedCount    Int              @default(0) @map("used_count")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  classGroup ClassGroup @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  creator    User       @relation("InvitationCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([classGroupId])
  @@index([status])
  @@map("class_invitations")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  details    Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model FraudReport {
  id           String        @id @default(uuid()) @db.Uuid
  title        String
  context      String?
  severity     FraudSeverity
  status       FraudStatus   @default(UNTREATED)
  studentId    String?       @map("student_id") @db.Uuid
  studentName  String        @map("student_name")
  studentCode  String?       @map("student_code")
  classGroupId String?       @map("class_group_id") @db.Uuid
  className    String?       @map("class_name")
  findings     Json          @default("[]")
  reason       String?
  resolution   String?
  occurredAt   DateTime      @map("occurred_at") @db.Timestamptz
  closedAt     DateTime?     @map("closed_at") @db.Timestamptz
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  student    User?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  classGroup ClassGroup? @relation(fields: [classGroupId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([severity])
  @@index([studentId])
  @@index([occurredAt])
  @@map("fraud_reports")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  familyId  String   @map("family_id") @db.Uuid
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model EmailVerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_codes")
}

model PasswordResetCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  attempts  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_codes")
}

model VideoSession {
  id                     String             @id @default(uuid()) @db.Uuid
  classGroupId           String             @map("class_group_id") @db.Uuid
  hostId                 String?            @map("host_id") @db.Uuid
  subject                String?            @db.VarChar(100)
  title                  String             @db.VarChar(200)
  description            String?            @db.Text
  startsAt               DateTime           @map("starts_at") @db.Timestamptz
  endsAt                 DateTime           @map("ends_at") @db.Timestamptz
  startedAt              DateTime?          @map("started_at") @db.Timestamptz
  endedAt                DateTime?          @map("ended_at") @db.Timestamptz
  status                 VideoSessionStatus @default(SCHEDULED)
  roomName               String             @unique @map("room_name")
  joinOpensMinutesBefore Int                @default(5) @map("join_opens_minutes_before")
  chatEnabled            Boolean            @default(true) @map("chat_enabled")
  timetableSlotId        String?            @map("timetable_slot_id") @db.Uuid
  courseId               String?            @map("course_id") @db.Uuid
  cancelReason           String?            @map("cancel_reason") @db.Text
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  classGroup    ClassGroup                  @relation(fields: [classGroupId], references: [id], onDelete: Cascade)
  host          User?                       @relation("HostedSessions", fields: [hostId], references: [id], onDelete: SetNull)
  timetableSlot TimetableSlot?              @relation(fields: [timetableSlotId], references: [id], onDelete: SetNull)
  course        Course?                     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  participants  SessionParticipant[]
  chatMessages  SessionChatMessage[]
  removals      SessionParticipantRemoval[]

  @@index([classGroupId, startsAt])
  @@index([hostId])
  @@index([status, startsAt])
  @@map("video_sessions")
}

model SessionParticipant {
  id        String    @id @default(uuid()) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  leftAt    DateTime? @map("left_at") @db.Timestamptz

  session VideoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, userId])
  @@map("session_participants")
}

model SessionChatMessage {
  id              String   @id @default(uuid()) @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  senderId        String   @map("sender_id") @db.Uuid
  clientMessageId String   @map("client_message_id") @db.Uuid
  content         String   @db.VarChar(2000)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  session VideoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sender  User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([sessionId, senderId, clientMessageId])
  @@index([sessionId, createdAt])
  @@map("session_chat_messages")
}

model SessionParticipantRemoval {
  id          String   @id @default(uuid()) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  removedById String   @map("removed_by_id") @db.Uuid
  reason      String?  @db.VarChar(500)
  removedAt   DateTime @default(now()) @map("removed_at") @db.Timestamptz

  session   VideoSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User         @relation("ParticipantRemovals", fields: [userId], references: [id], onDelete: Cascade)
  removedBy User         @relation("ExecutorRemovals", fields: [removedById], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("session_participant_removals")
}
