model LessonPackage {
  id                  String    @id @default(uuid()) @db.Uuid
  recordingId         String    @unique @map("recording_id") @db.Uuid
  version             Int       @default(1)
  structuredNotes     String    @default("") @map("structured_notes") @db.Text
  generalSummary      String    @default("") @map("general_summary") @db.Text
  keyConcepts         Json      @default("[]") @map("key_concepts")
  definitions         Json      @default("[]")
  importantExamples   Json      @default("[]") @map("important_examples")
  learningObjectives  String[]  @default([]) @map("learning_objectives")
  formulasAndRules    String[]  @default([]) @map("formulas_and_rules")
  importantMoments    Json      @default("[]") @map("important_moments")
  revisionSheet       String    @default("") @map("revision_sheet") @db.Text
  mindMapMermaid      String    @default("") @map("mind_map_mermaid") @db.Text
  suggestedStudyOrder String[]  @default([]) @map("suggested_study_order")
  flashcards          Json      @default("[]")
  quizzes             Json      @default("[]")
  qualityReport       Json      @default("{}") @map("quality_report")
  primaryModel        String?   @map("primary_model")
  secondaryModel      String?   @map("secondary_model")
  approvedById        String?   @map("approved_by_id") @db.Uuid
  approvedAt          DateTime? @map("approved_at") @db.Timestamptz
  publishedAt         DateTime? @map("published_at") @db.Timestamptz
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  recording Recording              @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  versions  LessonPackageVersion[]

  @@map("lesson_packages")
}

model LessonPackageVersion {
  id              String   @id @default(uuid()) @db.Uuid
  lessonPackageId String   @map("lesson_package_id") @db.Uuid
  version         Int
  snapshot        Json
  editedById      String?  @map("edited_by_id") @db.Uuid
  changeSummary   String?  @map("change_summary")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  lessonPackage LessonPackage @relation(fields: [lessonPackageId], references: [id], onDelete: Cascade)

  @@index([lessonPackageId, version])
  @@map("lesson_package_versions")
}

model StudentLessonArtifact {
  id          String            @id @default(uuid()) @db.Uuid
  recordingId String            @map("recording_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  kind        StudyArtifactKind
  title       String
  language    String            @default("fr")
  chapterIds  String[]          @default([]) @map("chapter_ids")
  config      Json              @default("{}")
  content     Json              @default("{}")
  modelUsed   String?           @map("model_used")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  recording Recording            @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
