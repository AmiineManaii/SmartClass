# Local LLM gateway (Ollama, OpenAI-compatible API, RG27)
# The API runs inside Docker: host.docker.internal reaches Ollama on the host.
# Token budgets per level: court 8K, normal 20K, complet 32K (capped by
# AI_MAX_TOKENS). Keep Ollama's context window >= 32768 (ideally ~48K) or
# normal/complet generations will fail.
# Plans run without thinking/tools; sections run with thinking + web search
# + examples/figures. URL imports default to web search and PDF imports to
# thinking + web search.
# AI_API_KEY is optional and lives ONLY in the local ignored .env; never
# commit it, never log it (redacted).
AI_BASE_URL=http://host.docker.internal:11434
AI_MODEL=gemma4:e4b
# Fallback Ollama model when the primary model is down.
AI_FALLBACK_MODEL=hf.co/unsloth/Qwen3.5-4B-GGUF:Q4_1
AI_API_KEY=
AI_TIMEOUT_MS=300000
AI_STATUS_TIMEOUT_MS=5000
AI_MAX_TOKENS=32768
AI_TEMPERATURE=0.7
AI_MAX_SOURCE_CHARS=16000
AI_ENABLE_WEB_SEARCH=true
AI_ENABLE_THINKING=true
AI_MAX_TOOL_ITERATIONS=10

# Hybrid Search: Optional Ollama Cloud Search API Key (leave empty for automatic free DuckDuckGo search)
OLLAMA_API_KEY=e2b5f04813a1483089d14059dca573c8._OfW6J0xoHtmytWYWLk8fign

# Local embedding server (Ollama, RG27). EmbeddingGemma -> 768-dim vectors.
# Pull first: `ollama pull embeddinggemma`. Used for course memory (pgvector).
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_TIMEOUT_MS=10000

# Local AI Image Generation (ComfyUI Desktop)
COMFYUI_BASE_URL=http://host.docker.internal:8188
COMFYUI_PUBLIC_URL=http://localhost:8188