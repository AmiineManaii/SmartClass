# Runtime environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (PostgreSQL 17 with pgvector)
# Use 'db' host when running inside Docker Compose, or 'localhost' when connecting from the host machine
DATABASE_URL=postgresql://smartclass:smartclass_dev_password@db:5432/smartclass

# Docker Compose database configuration
POSTGRES_USER=smartclass
POSTGRES_PASSWORD=smartclass_dev_password
POSTGRES_DB=smartclass

# Security & CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:8080
TRUST_PROXY=0

# Rate Limiting (Global /api/v1)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Authentication & Security
JWT_SECRET=smartclass-super-secret-jwt-key-min-32-chars-2026!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7
LOCKOUT_MAX_ATTEMPTS=3
LOCKOUT_DURATION_MINUTES=5
VERIFICATION_CODE_EXPIRATION_MINUTES=15
PASSWORD_RESET_EXPIRATION_MINUTES=15

# SMTP Email Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=faroukmessay006@gmail.com
# Provide your 16-character Google App Password (generated in Google Account > Security > 2-Step Verification > App Passwords)
SMTP_PASS=
SMTP_FROM=SmartClass <faroukmessay006@gmail.com>

# Local LLM gateway (Ollama, OpenAI-compatible API, RG27)
# The API runs inside Docker: host.docker.internal reaches Ollama on the host.
# Token budgets per level: court 8K, normal 20K, complet 32K (capped by
# AI_MAX_TOKENS). Keep Ollama's context window >= 32768 (ideally ~48K) or
# normal/complet generations will fail.
# Plans run without thinking/tools; sections run with thinking + web search
# + examples/figures. URL imports default to web search and PDF imports to
# thinking + web search.
# AI_API_KEY is optional and lives ONLY in the local ignored .env; never
# commit it, never log it (redacted).
AI_BASE_URL=http://host.docker.internal:11434
AI_MODEL=gemma4:e4b
# Fallback Ollama model when the primary model is down.
AI_FALLBACK_MODEL=qwen2.5:3b
AI_API_KEY=
AI_TIMEOUT_MS=300000
AI_STATUS_TIMEOUT_MS=5000
AI_MAX_TOKENS=32768
AI_TEMPERATURE=0.7
AI_MAX_SOURCE_CHARS=16000
AI_ENABLE_WEB_SEARCH=true

# Local embedding server (Ollama, RG27). EmbeddingGemma -> 768-dim vectors.
# Pull first: `ollama pull embeddinggemma`. Used for course memory (pgvector).
EMBEDDING_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=embeddinggemma
EMBEDDING_TIMEOUT_MS=10000

# ComfyUI (section illustrations) — SDXL workflow image_sdxl_simple.json
# (512x512) queued via /prompt and polled via /history.
# COMFYUI_BASE_URL = origin the BACKEND calls (from Docker use
# host.docker.internal:8188). COMFYUI_PUBLIC_URL = origin embedded in the
# imageUrl returned to the app (host.docker.internal does not resolve on the
# Flutter client; use your LAN IP from a device, ComfyUI must listen on
# 0.0.0.0 for that). Leave both empty to disable (503 IMAGE_SERVICE_UNAVAILABLE).
COMFYUI_BASE_URL=
COMFYUI_PUBLIC_URL=
