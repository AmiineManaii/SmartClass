TRUST_PROXY=0

# Rate Limiting (Global /api/v1)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Authentication & Security
JWT_SECRET=372f92ac8b1f54cf9145e62ac525d7dc75fb6d94c1ce139bb83dbc56df9f5c23f7ccecb5e20d95de28cb509da949ecf67aae54b76e1e0a4356a67541667eed66
